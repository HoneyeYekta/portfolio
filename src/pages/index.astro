---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';

const all = await getCollection('projects');
const published = all
  .filter((p) => p.data.status === 'published')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = published.slice(0, 2);
---

<Base>
  <Hero />

  <div class="timeline">
    <CareerTimeline />
  </div>

  <Section id="latest" icon="chart" title="Latest projects" moreHref="/projects/" moreLabel="All projects">
    <div class="grid">
      {latest.map((p) => <ProjectCard project={p} />)}
    </div>
  </Section>
</Base>

<style>
  .timeline {
    margin-top: 14px;
  }
  .grid {
    display: grid;
    gap: 14px;
  }
</style>
