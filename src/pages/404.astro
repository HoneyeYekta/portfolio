---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist.">
  <section class="nf">
    <p class="small muted nums">404</p>
    <h1>Page not found</h1>
    <p class="muted">The page you were looking for does not exist or has moved.</p>
    <p><a class="btn" href="/">Back to the homepage</a></p>
  </section>
</Base>

<style>
  .nf {
    padding-block: 48px;
    display: grid;
    gap: 10px;
  }
</style>
