---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import RailItem from '../components/RailItem.astro';
import PageHead from '../components/PageHead.astro';
import experience from '../data/experience.json';
import education from '../data/education.json';
import type { IconName } from '../components/Icon.astro';

type Kind = 'hr' | 'other' | 'training';
---

<Base title="Experience" description="Work experience, professional development and education of Honeye Yekta.">
  <PageHead
    icon="briefcase"
    eyebrow="Experience"
    title="Where I have worked"
    lead="Talent acquisition and HR consulting roles where data has become part of how I understand and improve hiring, with a period of professional development after moving to the Netherlands."
  />

  <h2 class="group-title">Professional experience</h2>
  <div class="group">
    {experience.map((job) => <ExperienceItem {...job} kind={job.kind as Kind} icon={job.icon as IconName} />)}
  </div>

  <Section id="education" icon="graduation" title="Education">
    <div class="group">
      {education.degrees.map((d) => (
        <RailItem icon="graduation">
          <div class="degree">
            <span>{d.title}</span>
            <span class="small muted">{d.school}</span>
          </div>
        </RailItem>
      ))}
    </div>
  </Section>
</Base>

<style>
  .group-title {
    font-size: 1.125rem;
    margin-bottom: 18px;
  }
  .degree {
    display: grid;
    gap: 1px;
  }
</style>
