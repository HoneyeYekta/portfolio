---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import experience from '../data/experience.json';
import education from '../data/education.json';

const hr = experience.filter((e) => e.kind === 'hr');
const additional = experience.filter((e) => e.kind !== 'hr');
---

<Base title="Experience" description="Work experience, additional experience and education of Honeye Yekta.">
  <header class="page-head">
    <p class="eyebrow">Experience</p>
    <h1>Where I have worked</h1>
    <p class="lead muted">Talent acquisition roles where I started using data to understand and improve the hiring process, and what I have been building since moving to the Netherlands.</p>
  </header>

  <h2 class="group-title">Professional experience</h2>
  {hr.map((job) => <ExperienceItem {...job} />)}

  <Section id="additional" title="Relocation to the Netherlands & additional experience">
    {additional.map((job) => <ExperienceItem {...job} />)}
  </Section>

  <Section id="education" title="Education">
    <ul class="plain">
      {education.degrees.map((d) => (
        <li>
          <span>{d.title}</span>
          <span class="small muted">{d.school}</span>
        </li>
      ))}
    </ul>
  </Section>
</Base>

<style>
  .group-title {
    font-size: 1.125rem;
    margin-bottom: 18px;
  }
  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
  }
  .plain li {
    display: grid;
    gap: 1px;
  }
</style>
