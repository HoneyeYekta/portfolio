---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PageHead from '../../components/PageHead.astro';

const all = await getCollection('projects');
const projects = all.sort((a, b) => {
  if (a.data.status !== b.data.status) return a.data.status === 'upcoming' ? -1 : 1;
  return b.data.date.getTime() - a.data.date.getTime();
});
---

<Base title="Projects" description="People Analytics mini-projects by Honeye Yekta, built on synthetic HR datasets and published on LinkedIn.">
  <PageHead
    icon="chart"
    eyebrow="Projects"
    title="People Analytics projects"
    lead="Mini-projects built on synthetic HR datasets, each exploring one question HR teams actually ask. New ones are added as they are published."
  />

  <div class="grid">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</Base>

<style>
  .grid {
    display: grid;
    gap: 16px;
  }
</style>
