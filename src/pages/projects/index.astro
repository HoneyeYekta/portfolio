---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const all = await getCollection('projects');
const projects = all.sort((a, b) => {
  if (a.data.status !== b.data.status) return a.data.status === 'upcoming' ? -1 : 1;
  return b.data.date.getTime() - a.data.date.getTime();
});
---

<Base title="Projects" description="People Analytics mini-projects by Honeye Yekta, built on synthetic HR datasets and published on LinkedIn.">
  <header class="page-head">
    <p class="eyebrow">Projects</p>
    <h1>People Analytics projects</h1>
    <p class="lead muted">
      Mini-projects built on synthetic HR datasets, each exploring one question HR teams actually ask. New ones are added as they are published.
    </p>
  </header>

  <div class="grid">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</Base>

<style>
  .grid {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
