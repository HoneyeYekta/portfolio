---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SkillChips from '../components/SkillChips.astro';
import PageHead from '../components/PageHead.astro';
import skills from '../data/skills.json';
import education from '../data/education.json';
---

<Base title="Skills" description="Talent acquisition and recruitment analytics skills, tools and languages of Honeye Yekta.">
  <PageHead icon="sparkles" eyebrow="Skills" title="Skills & tools" lead="What I work with today, and what I am currently building up." />

  <SkillChips icon="star" label="Core skills" items={skills.core} />
  <SkillChips icon="tools" label="Tools & systems" items={skills.tools} />
  <SkillChips icon="book" label="Additional learning" items={skills.learning} />

  <Section id="languages" icon="globe" title="Languages">
    <ul class="plain">
      {education.languages.map((l) => (
        <li>
          <span>{l.name}</span>
          <span class="small muted">{l.level}</span>
        </li>
      ))}
    </ul>
  </Section>
</Base>

<style>
  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .plain li {
    display: grid;
    gap: 1px;
  }
</style>
