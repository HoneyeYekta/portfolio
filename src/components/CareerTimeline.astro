---
/**
 * Gantt-style career timeline built from experience.json and education.json.
 * Pure HTML/CSS (no chart library), so it stays crisp and readable at any width.
 */
import experience from '../data/experience.json';
import education from '../data/education.json';
import { toFraction, fmtMonth, fmtRange, durationLabel } from '../lib/dates';

type Item = { label: string; sub: string; from: string; to: string | null; kind: 'role' | 'training' };

const now = new Date();
const items: Item[] = [
  ...experience.flatMap((job) =>
    job.roles.map((r) => ({ label: r.title, sub: job.company, from: r.from, to: r.to ?? null, kind: 'role' as const })),
  ),
  ...education.development.map((d) => ({ label: d.title, sub: 'Training', from: d.from, to: d.to ?? null, kind: 'training' as const })),
].sort((a, b) => toFraction(b.from) - toFraction(a.from));

const nowT = toFraction(null, now);
const minYear = Math.floor(Math.min(...items.map((i) => toFraction(i.from))));
const maxYear = Math.ceil(Math.max(...items.map((i) => toFraction(i.to, now))) + 0.01);
const span = maxYear - minYear;
const pct = (t: number) => ((t - minYear) / span) * 100;
const years = Array.from({ length: span + 1 }, (_, i) => minYear + i);
---

<figure class="tl" aria-labelledby="tl-title">
  <figcaption class="tl-head">
    <div>
      <h2 id="tl-title">Career timeline</h2>
      <p class="small muted">Roles and training, {minYear} to today</p>
    </div>
    <ul class="tl-legend" aria-label="Legend">
      <li><i class="sw role"></i>Role</li>
      <li><i class="sw training"></i>Training</li>
    </ul>
  </figcaption>

  <div class="tl-plot">
    <div class="tl-grid" aria-hidden="true">
      {years.map((y, i) => (
        <span class:list={['tl-year', { first: i === 0, last: i === years.length - 1 }]} style={`left:${pct(y)}%`}>
          <b>{y}</b>
        </span>
      ))}
      <span class="tl-now" style={`left:${pct(nowT)}%`}><b>now</b></span>
    </div>
    <ol class="tl-rows">
      {items.map((it) => {
        const x0 = pct(toFraction(it.from));
        const x1 = pct(toFraction(it.to, now));
        return (
          <li class="tl-row">
            <div class="tl-label">
              <span class="tl-name">{it.label}</span>
              <span class="small muted"> · {it.sub} · {durationLabel(it.from, it.to, now)}</span>
            </div>
            <div class="tl-track">
              <span class:list={['tl-bar', it.kind]} style={`left:${x0}%; width:${x1 - x0}%`}>
                <span class="sr-only">{fmtRange(it.from, it.to)}</span>
              </span>
              {!it.to && <span class:list={['tl-dot', it.kind]} style={`left:${x1}%`}></span>}
            </div>
          </li>
        );
      })}
    </ol>
  </div>

  <details class="tl-table">
    <summary class="small">View as table</summary>
    <table class="small nums">
      <thead>
        <tr><th>What</th><th>Where</th><th>From</th><th>To</th><th>Duration</th></tr>
      </thead>
      <tbody>
        {items.map((it) => (
          <tr>
            <td>{it.label}</td>
            <td>{it.sub}</td>
            <td>{fmtMonth(it.from)}</td>
            <td>{fmtMonth(it.to)}</td>
            <td>{durationLabel(it.from, it.to, now)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</figure>

<style>
  .tl {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 18px;
  }
  .tl-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .tl-head h2 {
    font-size: 1.05rem;
  }
  .tl-head p {
    margin: 2px 0 0;
  }
  .tl-legend {
    display: flex;
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.8rem;
    color: var(--ink-2);
  }
  .tl-legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .sw {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    display: inline-block;
  }
  .role {
    background: var(--chart-1);
  }
  .training {
    background: var(--chart-2);
  }

  .tl-plot {
    position: relative;
    padding: 18px 0 22px;
  }
  .tl-grid {
    position: absolute;
    inset: 18px 0 22px 0;
    pointer-events: none;
  }
  .tl-year,
  .tl-now {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--line);
  }
  .tl-year b,
  .tl-now b {
    position: absolute;
    font-weight: 400;
    font-size: 0.72rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    line-height: 1;
  }
  .tl-year b {
    top: 100%;
    margin-top: 6px;
    transform: translateX(-50%);
  }
  .tl-year.first b {
    transform: none;
  }
  .tl-year.last b {
    transform: translateX(-100%);
  }
  .tl-now {
    border-left-color: var(--ink-3);
  }
  .tl-now b {
    bottom: 100%;
    margin-bottom: 4px;
    transform: translateX(-50%);
    color: var(--ink-2);
  }

  .tl-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    display: grid;
    gap: 12px;
  }
  .tl-label {
    font-size: 0.85rem;
    line-height: 1.3;
    margin-bottom: 5px;
  }
  .tl-name {
    background: var(--surface);
    padding-right: 4px;
  }
  .tl-label .small {
    background: var(--surface);
    padding-right: 4px;
  }
  .tl-track {
    position: relative;
    height: 12px;
  }
  .tl-bar {
    position: absolute;
    top: 0;
    height: 12px;
    border-radius: 3px;
    min-width: 4px;
  }
  .tl-dot {
    position: absolute;
    top: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 2px var(--surface);
  }

  .tl-table {
    margin-top: 16px;
  }
  .tl-table summary {
    cursor: pointer;
    color: var(--ink-2);
  }
  .tl-table table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 8px;
  }
  .tl-table th,
  .tl-table td {
    text-align: left;
    padding: 6px 8px 6px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .tl-table th {
    font-weight: 500;
    color: var(--ink-2);
  }

  @media (max-width: 480px) {
    .tl-year:nth-child(even) b {
      display: none;
    }
  }
</style>
