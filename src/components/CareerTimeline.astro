---
/**
 * Gantt-style career timeline built from experience.json.
 * Pure HTML/CSS (no chart library), so it stays crisp and readable at any width.
 */
import experience from '../data/experience.json';
import { toFraction, fmtMonth, fmtRange, durationLabel } from '../lib/dates';

type Kind = 'hr' | 'training' | 'other';
type Item = { label: string; sub: string; from: string; to: string | null; kind: Kind };

const allSeries: { kind: Kind; label: string; plural: string }[] = [
  { kind: 'hr', label: 'Role', plural: 'roles' },
  { kind: 'other', label: 'Project', plural: 'projects' },
  { kind: 'training', label: 'Training', plural: 'training' },
];

const now = new Date();
const items: Item[] = experience
  .flatMap((job) =>
    job.roles.map((r) => ({
      label: r.title,
      sub: ('short' in job && job.short) || job.company,
      from: r.from,
      to: r.to ?? null,
      kind: job.kind as Kind,
    })),
  )
  .sort((a, b) => toFraction(b.from) - toFraction(a.from));

// Only the series that actually appear in the data show up in the legend.
const series = allSeries.filter((s) => items.some((i) => i.kind === s.kind));
const what = series.map((s) => s.plural);
const whatText = what.length > 1 ? `${what.slice(0, -1).join(', ')} and ${what[what.length - 1]}` : what[0] ?? '';

const nowT = toFraction(null, now);
const minYear = Math.floor(Math.min(...items.map((i) => toFraction(i.from))));
const maxYear = Math.ceil(Math.max(...items.map((i) => toFraction(i.to, now, true))) + 0.01);
const span = maxYear - minYear;
const pct = (t: number) => ((t - minYear) / span) * 100;
const years = Array.from({ length: span + 1 }, (_, i) => minYear + i);
const capital = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<figure class="tl" aria-labelledby="tl-title">
  <figcaption class="tl-head">
    <div>
      <h2 id="tl-title">Career timeline</h2>
      <p class="small muted">{capital(whatText)}, {minYear} to today</p>
    </div>
    {series.length > 1 && (
      <ul class="tl-legend" aria-label="Legend">
        {series.map((s) => (
          <li><i class:list={['sw', s.kind]}></i>{s.label}</li>
        ))}
      </ul>
    )}
  </figcaption>

  <div class="tl-plot">
    <div class="tl-grid" aria-hidden="true">
      {years.map((y, i) => (
        <span class:list={['tl-year', { first: i === 0, last: i === years.length - 1 }]} style={`left:${pct(y)}%`}>
          <b>{y}</b>
        </span>
      ))}
      <span class="tl-now" style={`left:${pct(nowT)}%`}><b>now</b></span>
    </div>
    <ol class="tl-rows">
      {items.map((it) => {
        const x0 = pct(toFraction(it.from));
        const x1 = pct(toFraction(it.to, now, true));
        const dur = durationLabel(it.from, it.to, now);
        return (
          <li class="tl-row">
            <div class="tl-label">
              <span class="tl-name">{it.label}</span>
              <span class="small muted"> · {it.sub}{dur && ` · ${dur}`}</span>
            </div>
            <div class="tl-track">
              <span class:list={['tl-bar', it.kind]} style={`left:${x0}%; width:${x1 - x0}%`}>
                <span class="sr-only">{fmtRange(it.from, it.to)}</span>
              </span>
              {!it.to && <span class:list={['tl-dot', it.kind]} style={`left:${x1}%`}></span>}
            </div>
          </li>
        );
      })}
    </ol>
  </div>

  <details class="tl-table">
    <summary class="small">View as table</summary>
    <table class="small nums">
      <thead>
        <tr><th>What</th><th>Where</th><th>Type</th><th>From</th><th>To</th></tr>
      </thead>
      <tbody>
        {items.map((it) => (
          <tr>
            <td>{it.label}</td>
            <td>{it.sub}</td>
            <td>{allSeries.find((s) => s.kind === it.kind)?.label}</td>
            <td>{fmtMonth(it.from)}</td>
            <td>{fmtMonth(it.to)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</figure>

<style>
  .tl {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 18px;
  }
  .tl-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .tl-head h2 {
    font-size: 1.05rem;
  }
  .tl-head p {
    margin: 2px 0 0;
  }
  .tl-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.8rem;
    color: var(--ink-2);
  }
  .tl-legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .sw {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    display: inline-block;
  }
  .hr {
    background: var(--chart-1);
  }
  .training {
    background: var(--chart-2);
  }
  .other {
    background: var(--chart-3);
  }

  .tl-plot {
    position: relative;
    padding: 18px 0 22px;
  }
  .tl-grid {
    position: absolute;
    inset: 18px 0 22px 0;
    pointer-events: none;
  }
  .tl-year,
  .tl-now {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--line);
  }
  .tl-year b,
  .tl-now b {
    position: absolute;
    font-weight: 400;
    font-size: 0.72rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    line-height: 1;
  }
  .tl-year b {
    top: 100%;
    margin-top: 6px;
    transform: translateX(-50%);
  }
  .tl-year.first b {
    transform: none;
  }
  .tl-year.last b {
    transform: translateX(-100%);
  }
  .tl-now {
    border-left-color: var(--ink-3);
  }
  .tl-now b {
    bottom: 100%;
    margin-bottom: 4px;
    transform: translateX(-50%);
    color: var(--ink-2);
  }

  .tl-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    display: grid;
    gap: 12px;
  }
  .tl-label {
    font-size: 0.85rem;
    line-height: 1.3;
    margin-bottom: 5px;
  }
  .tl-name,
  .tl-label .small {
    background: var(--surface);
    padding-right: 4px;
  }
  .tl-track {
    position: relative;
    height: 12px;
  }
  .tl-bar {
    position: absolute;
    top: 0;
    height: 12px;
    border-radius: 3px;
    min-width: 4px;
  }
  .tl-dot {
    position: absolute;
    top: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 2px var(--surface);
  }

  .tl-table {
    margin-top: 16px;
  }
  .tl-table summary {
    cursor: pointer;
    color: var(--ink-2);
  }
  .tl-table table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 8px;
  }
  .tl-table th,
  .tl-table td {
    text-align: left;
    padding: 6px 8px 6px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .tl-table th {
    font-weight: 500;
    color: var(--ink-2);
  }

  @media (max-width: 480px) {
    .tl-year:nth-child(even) b {
      display: none;
    }
  }
</style>
