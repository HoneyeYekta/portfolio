---
import profile from '../data/profile.json';
import ExternalIcon from './ExternalIcon.astro';
import EmailLink from './EmailLink.astro';
const { links } = profile;
---

<section class="hero" aria-labelledby="hero-title">
  <p class="eyebrow">{profile.headline}</p>
  <h1 id="hero-title">{profile.tagline}</h1>
  <p class="summary muted">{profile.summary}</p>
  <div class="actions">
    <a class="btn btn-primary" href={links.linkedin} target="_blank" rel="me noopener">LinkedIn <ExternalIcon /></a>
    <a class="btn" href={links.github} target="_blank" rel="me noopener">GitHub <ExternalIcon /></a>
    <EmailLink class="btn" label="Email" />
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding: 8px 0 36px;
  }
  /* faint dot grid: a nod to graph paper */
  .hero::before {
    content: '';
    position: absolute;
    inset: -24px 0 0 -24px;
    z-index: -1;
    background-image: radial-gradient(var(--line) 1px, transparent 1.5px);
    background-size: 18px 18px;
    -webkit-mask-image: radial-gradient(ellipse 70% 90% at 20% 0%, #000 30%, transparent 80%);
    mask-image: radial-gradient(ellipse 70% 90% at 20% 0%, #000 30%, transparent 80%);
  }
  h1 {
    font-size: clamp(1.7rem, 4.5vw, 2.3rem);
    max-width: 22ch;
  }
  .summary {
    max-width: 58ch;
    margin-top: 14px;
  }
  .actions {
    margin-top: 20px;
  }
</style>
