---
import RailItem from './RailItem.astro';
import type { IconName } from './Icon.astro';
import { fmtRange } from '../lib/dates';

interface Props {
  kind?: 'hr' | 'other' | 'training';
  icon?: IconName;
  company: string;
  /** Shorter name used on the career timeline. */
  short?: string;
  note?: string;
  location?: string;
  roles: { title: string; from: string; to?: string | null }[];
  intro?: string;
  bullets: string[];
}
const { kind = 'hr', icon = 'linkedin', company, note, location, roles, intro, bullets } = Astro.props;
---

<RailItem icon={icon} tone={kind}>
  <article class="job">
    <header>
      <h3>{company}{location && <span class="muted small location"> · {location}</span>}</h3>
      {note && <p class="small muted note">{note}</p>}
    </header>
    <ul class="roles">
      {roles.map((r) => (
        <li>
          <span class="role">{r.title}</span>
          <span class="dates small muted nums">{fmtRange(r.from, r.to)}</span>
        </li>
      ))}
    </ul>
    {intro && <p class="intro muted">{intro}</p>}
    <ul class="bullets">
      {bullets.map((b) => <li>{b}</li>)}
    </ul>
  </article>
</RailItem>

<style>
  h3 {
    font-size: 1.05rem;
  }
  .location {
    font-weight: 400;
  }
  .note {
    margin: 2px 0 0;
  }
  .roles {
    list-style: none;
    padding: 0;
    margin: 12px 0;
    display: grid;
    gap: 4px;
  }
  .roles li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 16px;
  }
  .role {
    font-weight: 500;
  }
  .intro {
    font-size: 0.95rem;
    margin: -4px 0 10px;
  }
  .bullets {
    color: var(--ink-2);
    font-size: 0.95rem;
    display: grid;
    gap: 6px;
  }
</style>
