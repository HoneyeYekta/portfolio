---
import type { CollectionEntry } from 'astro:content';
import ExternalIcon from './ExternalIcon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, summary, date, tools, link, article, image, status } = project.data;
const upcoming = status === 'upcoming';
const showImage = Boolean(image) && !upcoming;
const href = `/projects/${project.id}/`;
const when = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' }).format(date);
const external = article ?? link;
---

<article class:list={['card', { upcoming, 'has-image': showImage }]}>
  {showImage && (
    <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
      <img src={image} alt="" loading="lazy" width="640" height="400" />
    </a>
  )}
  <div class="body">
    <div class="meta small muted">
      <span class="nums">{when}</span>
      {upcoming && <span class="tag">Coming soon</span>}
    </div>
    <h3>{upcoming ? title : <a href={href}>{title}</a>}</h3>
    <p class="summary muted">{summary}</p>
    <div class="foot">
      {tools.length > 0 && (
        <ul class="chips" aria-label="Tools">
          {tools.map((t) => <li class="chip">{t}</li>)}
        </ul>
      )}
      {!upcoming && external && (
        <a class="more small" href={external} target="_blank" rel="noopener">Read on LinkedIn <ExternalIcon /></a>
      )}
    </div>
  </div>
</article>

<style>
  .card {
    display: grid;
    gap: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 14px;
  }
  .card.upcoming {
    border-style: dashed;
    background: transparent;
  }
  .thumb {
    display: block;
  }
  .thumb img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 7px;
    border: 1px solid var(--line);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 2px 4px 4px;
    min-width: 0;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .tag {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 1px 8px;
    font-size: 0.75rem;
  }
  h3 {
    font-size: 1.05rem;
  }
  h3 a {
    color: var(--ink);
  }
  h3 a:hover {
    color: var(--accent);
  }
  .summary {
    font-size: 0.95rem;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    margin-top: auto;
    padding-top: 4px;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .card.has-image {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 18px;
    }
    .thumb {
      align-self: start;
    }
  }
</style>
