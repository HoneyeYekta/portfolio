---
import type { CollectionEntry } from 'astro:content';
import ExternalIcon from './ExternalIcon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, summary, date, tools, link, article, image, status } = project.data;
const upcoming = status === 'upcoming';
const href = `/projects/${project.id}/`;
const when = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' }).format(date);
const external = article ?? link;
---

<article class:list={['card', { upcoming }]}>
  {image && !upcoming && (
    <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
      <img src={image} alt="" loading="lazy" width="640" height="400" />
    </a>
  )}
  <div class="body">
    <div class="meta small muted">
      <span class="nums">{when}</span>
      {upcoming && <span class="tag">Coming soon</span>}
    </div>
    <h3>{upcoming ? title : <a href={href}>{title}</a>}</h3>
    <p class="summary muted">{summary}</p>
    {tools.length > 0 && (
      <ul class="chips" aria-label="Tools">
        {tools.map((t) => <li class="chip">{t}</li>)}
      </ul>
    )}
    {!upcoming && external && (
      <a class="more small" href={external} target="_blank" rel="noopener">Read on LinkedIn <ExternalIcon /></a>
    )}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .card.upcoming {
    border-style: dashed;
    background: transparent;
  }
  .thumb {
    display: block;
    border-bottom: 1px solid var(--line);
  }
  .thumb img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 18px 18px;
    flex: 1;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .tag {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 1px 8px;
    font-size: 0.75rem;
  }
  h3 {
    font-size: 1.05rem;
  }
  h3 a {
    color: var(--ink);
  }
  h3 a:hover {
    color: var(--accent);
  }
  .summary {
    font-size: 0.95rem;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    margin-top: auto;
  }
</style>
