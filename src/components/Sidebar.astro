---
import profile from '../data/profile.json';
import ContactLinks from './ContactLinks.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/experience/', label: 'Experience' },
  { href: '/skills/', label: 'Skills' },
  { href: '/hobbies/', label: 'Hobbies' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<aside class="sidebar">
  <a class="who" href="/">
    <img
      class="avatar"
      src={profile.photo.src}
      srcset={profile.photo.srcset}
      sizes="(min-width: 900px) 96px, 40px"
      width="96"
      height="96"
      alt={profile.photo.alt}
    />
    <span class="who-text">
      <span class="name">{profile.name}</span>
      <span class="role small muted">{profile.headline}</span>
      <span class="loc small muted">{profile.location}</span>
    </span>
  </a>

  <button class="theme-toggle" type="button" aria-label="Switch colour theme">
    <svg class="icon icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
    </svg>
    <svg class="icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" />
    </svg>
  </button>

  <nav aria-label="Main">
    <ul>
      {nav.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="sb-bottom">
    <ContactLinks heading="Contact" class="stacked" />
    <p class="made small muted">{profile.madeWith}</p>
  </div>
</aside>

<script>
  const root = document.documentElement;
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
  const current = () => root.dataset.theme ?? (prefersDark.matches ? 'dark' : 'light');
  const describe = (btn: HTMLButtonElement) => {
    const next = current() === 'dark' ? 'light' : 'dark';
    btn.setAttribute('aria-label', `Switch to ${next} mode`);
    btn.title = `Switch to ${next} mode`;
  };
  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((btn) => {
    describe(btn);
    btn.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      describe(btn);
    });
  });
</script>

<style>
  /* Mobile: compact top bar */
  .sidebar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    padding: 12px var(--gutter);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .who {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
  }
  .who:hover {
    text-decoration: none;
  }
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line);
  }
  .who-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .name {
    font-weight: 600;
  }
  .role,
  .loc {
    display: none;
  }
  .theme-toggle {
    margin-left: auto;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink-2);
    cursor: pointer;
    padding: 0;
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .theme-toggle .icon {
    width: 18px;
    height: 18px;
  }
  nav {
    flex-basis: 100%;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--ink-2);
    font-size: 0.9rem;
    padding: 4px 0;
    display: inline-block;
  }
  nav a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .sb-bottom {
    display: none;
  }

  /* Desktop: sticky left column */
  @media (min-width: 900px) {
    .sidebar {
      position: sticky;
      top: 0;
      flex: none;
      width: var(--sidebar);
      height: 100dvh;
      overflow-y: auto;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 32px;
      padding: 40px 28px 28px;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .who {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .avatar {
      width: 96px;
      height: 96px;
    }
    .who-text {
      gap: 2px;
    }
    .name {
      font-size: 1.15rem;
    }
    .role,
    .loc {
      display: block;
    }
    .loc {
      color: var(--ink-3);
    }
    .theme-toggle {
      position: absolute;
      top: 28px;
      right: 24px;
      margin: 0;
    }
    nav {
      flex-basis: auto;
    }
    nav ul {
      flex-direction: column;
      gap: 2px;
    }
    nav a {
      display: block;
      padding: 6px 0 6px 14px;
      position: relative;
      font-size: 0.95rem;
    }
    nav a::before {
      content: '';
      position: absolute;
      left: 0;
      top: 8px;
      bottom: 8px;
      width: 3px;
      border-radius: 2px;
      background: transparent;
    }
    nav a[aria-current='page'] {
      box-shadow: none;
    }
    nav a[aria-current='page']::before {
      background: var(--accent);
    }
    .sb-bottom {
      display: block;
      margin-top: auto;
      display: grid;
      gap: 18px;
    }
    .made {
      margin: 0;
      color: var(--ink-3);
    }
  }
</style>
