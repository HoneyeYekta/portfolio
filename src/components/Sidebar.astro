---
import profile from '../data/profile.json';
import ContactLinks from './ContactLinks.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/experience/', label: 'Experience' },
  { href: '/skills/', label: 'Skills' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<aside class="sidebar">
  <a class="who" href="/">
    <img
      class="avatar"
      src={profile.photo.src}
      srcset={profile.photo.srcset}
      sizes="(min-width: 900px) 96px, 40px"
      width="96"
      height="96"
      alt={profile.photo.alt}
    />
    <span class="who-text">
      <span class="name">{profile.name}</span>
      <span class="role small muted">{profile.headline}</span>
      <span class="loc small muted">{profile.location}</span>
    </span>
  </a>

  <nav aria-label="Main">
    <ul>
      {nav.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="sb-bottom">
    <ContactLinks heading="Contact" class="stacked" />
    <p class="made small muted">{profile.madeWith}</p>
  </div>
</aside>

<style>
  /* Mobile: compact top bar */
  .sidebar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    padding: 12px var(--gutter);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .who {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
  }
  .who:hover {
    text-decoration: none;
  }
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line);
  }
  .who-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .name {
    font-weight: 600;
  }
  .role,
  .loc {
    display: none;
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--ink-2);
    font-size: 0.9rem;
    padding: 4px 0;
    display: inline-block;
  }
  nav a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .sb-bottom {
    display: none;
  }

  /* Desktop: sticky left column */
  @media (min-width: 900px) {
    .sidebar {
      position: sticky;
      top: 0;
      flex: none;
      width: var(--sidebar);
      height: 100dvh;
      overflow-y: auto;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 32px;
      padding: 40px 28px 28px;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .who {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .avatar {
      width: 96px;
      height: 96px;
    }
    .who-text {
      gap: 2px;
    }
    .name {
      font-size: 1.15rem;
    }
    .role,
    .loc {
      display: block;
    }
    .loc {
      color: var(--ink-3);
    }
    nav {
      margin-left: 0;
    }
    nav ul {
      flex-direction: column;
      gap: 2px;
    }
    nav a {
      display: block;
      padding: 6px 0 6px 14px;
      position: relative;
      font-size: 0.95rem;
    }
    nav a::before {
      content: '';
      position: absolute;
      left: 0;
      top: 8px;
      bottom: 8px;
      width: 3px;
      border-radius: 2px;
      background: transparent;
    }
    nav a[aria-current='page'] {
      box-shadow: none;
    }
    nav a[aria-current='page']::before {
      background: var(--accent);
    }
    .sb-bottom {
      display: block;
      margin-top: auto;
      display: grid;
      gap: 18px;
    }
    .made {
      margin: 0;
      color: var(--ink-3);
    }
  }
</style>
