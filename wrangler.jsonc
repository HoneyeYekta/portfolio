{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
  // To attach a custom domain later, add e.g.:
  // "routes": [{ "pattern": "honeyeyekta.com", "custom_domain": true }]
}
