{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Custom domain (DNS zone on the same Cloudflare account). The *.workers.dev URL stays available too.
  "routes": [{ "pattern": "honeye.me", "custom_domain": true }]
}
